# Copy to .env.local (local) or add these in Vercel > Project > Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose it in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the site, no trailing slash (used for canonical URLs, sitemap and structured data).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
